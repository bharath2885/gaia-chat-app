# =============================================================================
# Gaia Chat App — Backend
# Build context is the 02-chat-app directory (self-contained).
# The gaia-sdk is bundled in the gaia-sdk/ subfolder.
#
# Usage (handled automatically by docker-compose):
#   docker compose build backend
# =============================================================================

FROM python:3.12-slim

# ── System deps ──────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# ── Install bundled gaia-sdk (not on PyPI) ───────────────────────────────────
COPY gaia-sdk /tmp/gaia-sdk
RUN pip install --no-cache-dir /tmp/gaia-sdk

# ── Install remaining Python dependencies ────────────────────────────────────
COPY backend/requirements.txt /tmp/requirements.txt
# Filter out gaia-sdk line to avoid PyPI lookup (already installed above)
RUN grep -v "^gaia-sdk" /tmp/requirements.txt > /tmp/requirements-filtered.txt \
    && pip install --no-cache-dir -r /tmp/requirements-filtered.txt

# ── Copy application source ───────────────────────────────────────────────────
COPY backend ./backend

# ── Logs directory ────────────────────────────────────────────────────────────
RUN mkdir -p /app/logs

# ── Run ───────────────────────────────────────────────────────────────────────
EXPOSE 8000
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
