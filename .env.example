# =============================================================================
# Gaia Chat App — environment configuration
# =============================================================================
# 1. Copy this file:   cp .env.example .env
# 2. Fill in your values below (at minimum GAIA_API_KEY is required)
# 3. Run:              docker compose up --build
# =============================================================================

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# Your Cohesity Helios API key
# How to get one: Helios → Settings → API Keys → Create API Key (Super Admin)
GAIA_API_KEY=your-api-key-here

# ── OPTIONAL (defaults work for most setups) ──────────────────────────────────

# Gaia / Helios API endpoint
GAIA_BASE_URL=https://helios.cohesity.com/v2/mcm/gaia

# Set to true if your Helios instance uses a trusted certificate
GAIA_VERIFY_SSL=false

# How long to wait on Gaia API calls (seconds)
REQUEST_TIMEOUT_SECONDS=60

# How long to keep a session alive without activity (minutes)
SESSION_TTL_MINUTES=60

# CORS — only change this if you're accessing the frontend from a different host
ALLOW_CORS_ORIGIN=http://localhost:5173
